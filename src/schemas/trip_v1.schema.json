{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-travel-planner.local/schemas/trip-v1.schema.json",
  "title": "Canonical Trip V1",
  "description": "The single source of truth for a planned trip. Candidate research remains in candidate_sets; selected decisions are referenced by the itinerary.",
  "type": "object",
  "required": ["schema_version", "id", "title", "local_timezone", "date_range", "traveler_profile", "preferences", "candidate_sets", "days", "budget", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "trip-v1"},
    "id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "local_timezone": {"type": "string", "description": "IANA timezone, e.g. Asia/Tokyo."},
    "date_range": {"$ref": "#/$defs/dateRange"},
    "traveler_profile": {"$ref": "#/$defs/travelerProfile"},
    "preferences": {"$ref": "#/$defs/userPreference"},
    "candidate_sets": {"$ref": "#/$defs/candidateSets"},
    "selected": {"$ref": "#/$defs/selected"},
    "days": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dayPlan"}},
    "budget": {"$ref": "#/$defs/budget"},
    "validation": {"type": "array", "items": {"$ref": "#/$defs/validationViolation"}},
    "overrides": {"type": "array", "items": {"$ref": "#/$defs/userOverride"}},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "money": {"type": "object", "required": ["amount", "currency"], "additionalProperties": false, "properties": {"amount": {"type": "number", "minimum": 0}, "currency": {"$ref": "#/$defs/currency"}}},
    "dateRange": {"type": "object", "required": ["start_date", "end_date"], "additionalProperties": false, "properties": {"start_date": {"type": "string", "format": "date"}, "end_date": {"type": "string", "format": "date"}}},
    "provenance": {"type": "object", "required": ["source_type", "provider", "retrieved_at", "status"], "additionalProperties": false, "properties": {"source_type": {"enum": ["user_input", "official", "provider", "community", "derived"]}, "provider": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "format": "uri"}, "retrieved_at": {"$ref": "#/$defs/timestamp"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "status": {"enum": ["confirmed", "reported", "estimated", "unverified"]}, "note": {"type": "string"}}},
    "place": {"type": "object", "required": ["id", "name", "kind"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string"}, "kind": {"enum": ["poi", "restaurant", "hotel", "airport", "station", "parking", "other"]}, "address": {"type": "string"}, "coordinates": {"type": "object", "required": ["latitude", "longitude"], "additionalProperties": false, "properties": {"latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}}}, "opening_hours_note": {"type": "string"}, "accessibility_notes": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "restaurantCandidate": {"type": "object", "required": ["place", "provenance"], "additionalProperties": false, "properties": {"place": {"$ref": "#/$defs/place"}, "price_range": {"type": "string"}, "rating": {"type": "number", "minimum": 0}, "rating_source": {"type": "string"}, "review_count": {"type": "integer", "minimum": 0}, "cuisine": {"type": "string"}, "recommended_dishes": {"type": "array", "items": {"type": "object", "required": ["name", "provenance"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "note": {"type": "string"}, "provenance": {"$ref": "#/$defs/provenance"}}}}, "opening_hours": {"type": "object", "required": ["status", "intervals"], "additionalProperties": false, "properties": {"status": {"enum": ["fresh", "stale", "unverified"]}, "intervals": {"type": "array", "items": {"type": "object", "required": ["weekday", "opens_at", "closes_at"], "additionalProperties": false, "properties": {"weekday": {"type": "integer", "minimum": 0, "maximum": 6}, "opens_at": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}, "closes_at": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"}}}}}}, "reservation_required": {"type": "boolean"}, "reservation_url": {"type": "string", "format": "uri"}, "wait_risk": {"enum": ["low", "medium", "high", "unknown"]}, "child_friendly": {"type": "boolean"}, "smoking_policy": {"type": "string"}, "parking_available": {"type": "boolean"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "hotelCandidate": {"type": "object", "required": ["place", "provenance"], "additionalProperties": false, "properties": {"place": {"$ref": "#/$defs/place"}, "nightly_cost": {"$ref": "#/$defs/money"}, "total_cost": {"$ref": "#/$defs/money"}, "taxes_fees": {"$ref": "#/$defs/money"}, "check_in": {"type": "string"}, "check_out": {"type": "string"}, "occupancy": {"type": "object", "required": ["adults", "child_ages"], "additionalProperties": false, "properties": {"adults": {"type": "integer", "minimum": 1}, "child_ages": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 17}}}}, "room_type": {"type": "string"}, "cancellation_policy": {"type": "string"}, "parking_available": {"type": "boolean"}, "child_policy": {"type": "string"}, "provider_reference": {"type": "string"}, "search_url": {"type": "string", "format": "uri"}, "price_status": {"enum": ["fresh", "stale", "unverified"]}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "flightOption": {"type": "object", "required": ["id", "carrier", "flight_number", "departure", "arrival", "provenance"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "carrier": {"type": "string"}, "flight_number": {"type": "string"}, "departure": {"$ref": "#/$defs/timedPlace"}, "arrival": {"$ref": "#/$defs/timedPlace"}, "cost": {"$ref": "#/$defs/money"}, "direct": {"type": "boolean"}, "transfer_count": {"type": "integer", "minimum": 0}, "fare_family": {"type": "string"}, "baggage": {"type": "object"}, "provider_reference": {"type": "string"}, "search_url": {"type": "string", "format": "uri"}, "price_status": {"enum": ["fresh", "stale", "unverified"]}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "timedPlace": {"type": "object", "required": ["place_id", "at"], "additionalProperties": false, "properties": {"place_id": {"$ref": "#/$defs/id"}, "at": {"$ref": "#/$defs/timestamp"}}},
    "transportLeg": {"type": "object", "required": ["id", "mode", "from_place_id", "to_place_id", "departure_at", "arrival_at"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "mode": {"enum": ["flight", "car", "train", "bus", "taxi", "walk", "ferry", "other"]}, "from_place_id": {"$ref": "#/$defs/id"}, "to_place_id": {"$ref": "#/$defs/id"}, "departure_at": {"$ref": "#/$defs/timestamp"}, "arrival_at": {"$ref": "#/$defs/timestamp"}, "cost": {"$ref": "#/$defs/money"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "itineraryItem": {"type": "object", "required": ["id", "kind", "place_id", "start_at", "end_at", "selection_status"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["visit", "meal", "check_in", "check_out", "transport", "free_time"]}, "place_id": {"$ref": "#/$defs/id"}, "start_at": {"$ref": "#/$defs/timestamp"}, "end_at": {"$ref": "#/$defs/timestamp"}, "transport_leg_id": {"$ref": "#/$defs/id"}, "selection_status": {"const": "selected"}, "notes": {"type": "string"}, "alternative_place_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "dayPlan": {"type": "object", "required": ["date", "items"], "additionalProperties": false, "properties": {"date": {"type": "string", "format": "date"}, "summary": {"type": "string"}, "items": {"type": "array", "items": {"$ref": "#/$defs/itineraryItem"}}}},
    "travelerProfile": {"type": "object", "required": ["adults", "children"], "additionalProperties": false, "properties": {"adults": {"type": "integer", "minimum": 1}, "children": {"type": "array", "items": {"type": "object", "required": ["age"], "additionalProperties": false, "properties": {"age": {"type": "integer", "minimum": 0}, "notes": {"type": "string"}}}}, "accessibility_needs": {"type": "array", "items": {"type": "string"}}}},
    "constraint": {"type": "object", "required": ["id", "kind", "description"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "description": {"type": "string"}, "value": {}}},
    "userPreference": {"type": "object", "required": ["hard_constraints", "soft_preferences"], "additionalProperties": false, "properties": {"hard_constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}}, "soft_preferences": {"type": "array", "items": {"$ref": "#/$defs/constraint"}}}},
    "candidateSets": {"type": "object", "required": ["places", "restaurants", "hotels", "flights", "transport_legs"], "additionalProperties": false, "properties": {"places": {"type": "array", "items": {"$ref": "#/$defs/place"}}, "restaurants": {"type": "array", "items": {"$ref": "#/$defs/restaurantCandidate"}}, "hotels": {"type": "array", "items": {"$ref": "#/$defs/hotelCandidate"}}, "flights": {"type": "array", "items": {"$ref": "#/$defs/flightOption"}}, "transport_legs": {"type": "array", "items": {"$ref": "#/$defs/transportLeg"}}}},
    "selected": {"type": "object", "additionalProperties": false, "properties": {"hotel_place_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "flight_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}},
    "budget": {"type": "object", "required": ["currency", "categories", "total"], "additionalProperties": false, "properties": {"currency": {"$ref": "#/$defs/currency"}, "categories": {"type": "object", "additionalProperties": {"$ref": "#/$defs/money"}}, "total": {"$ref": "#/$defs/money"}}},
    "validationViolation": {"type": "object", "required": ["code", "severity", "message"], "additionalProperties": false, "properties": {"code": {"type": "string"}, "severity": {"enum": ["error", "warning"]}, "message": {"type": "string"}, "path": {"type": "string"}}},
    "userOverride": {"type": "object", "required": ["id", "path", "value", "preserve_on_replan", "provenance"], "additionalProperties": false, "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "pattern": "^/"}, "value": {}, "preserve_on_replan": {"const": true}, "provenance": {"$ref": "#/$defs/provenance"}}}
  }
}
