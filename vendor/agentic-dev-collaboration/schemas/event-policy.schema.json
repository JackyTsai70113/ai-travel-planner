{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/event-policy.schema.json",
  "title": "Lifecycle Event Authorization Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "events",
    "allowed_executables",
    "denied_executables"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed_modes",
          "allowed_agents",
          "assignment_required",
          "blocking_required"
        ],
        "properties": {
          "allowed_modes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "allowed_agents": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string"}
          },
          "assignment_required": {"type": "boolean"},
          "blocking_required": {"type": "boolean"}
        }
      }
    },
    "allowed_executables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": {"$ref": "#/$defs/executableName"},
          "kind": {
            "enum": ["direct_tool", "interpreter", "shell", "dispatcher"]
          }
        }
      }
    },
    "denied_executables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/executableName"
      }
    }
  },
  "$defs": {
    "executableName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.+-]*$"
    }
  }
}
