{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/finding.schema.json",
  "title": "Review Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "task_id",
    "reviewer",
    "severity",
    "category",
    "claim",
    "evidence",
    "impact",
    "status",
    "disposition",
    "resolution_evidence",
    "resolution_reviewer"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "task_id": {"type": "string"},
    "reviewer": {"type": "string"},
    "severity": {
      "enum": ["critical", "high", "medium", "low"]
    },
    "category": {
      "enum": [
        "specification",
        "correctness",
        "security",
        "reliability",
        "performance",
        "maintainability",
        "accessibility",
        "compatibility",
        "evidence"
      ]
    },
    "claim": {"type": "string", "minLength": 15},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "observation"],
        "properties": {
          "location": {"type": "string"},
          "observation": {"type": "string"}
        }
      }
    },
    "impact": {"type": "string", "minLength": 10},
    "suggested_remediation": {"type": ["string", "null"]},
    "status": {
      "enum": ["open", "accepted", "fixed", "verified", "deferred", "rejected"]
    },
    "disposition": {"type": ["string", "null"]},
    "resolution_evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "resolution_reviewer": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"enum": ["fixed", "verified"]}
        }
      },
      "then": {
        "properties": {
          "disposition": {"type": "string", "minLength": 15},
          "resolution_evidence": {"minItems": 1},
          "resolution_reviewer": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "rejected"}
        }
      },
      "then": {
        "properties": {
          "disposition": {"type": "string", "minLength": 15},
          "resolution_reviewer": {"type": "string", "minLength": 1}
        }
      }
    }
  ]
}
