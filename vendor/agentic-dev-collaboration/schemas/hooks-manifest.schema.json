{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/hooks-manifest.schema.json",
  "title": "Hooks Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hooks"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event",
          "blocking",
          "command",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+$"
          },
          "event": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
