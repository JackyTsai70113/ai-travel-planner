{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/lesson.schema.json",
  "title": "Validated Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "status",
    "statement",
    "evidence",
    "scope",
    "counterexamples",
    "confidence",
    "policy_candidate"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "pattern": "^L-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "hypothesis",
        "validated",
        "rejected",
        "superseded"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 20
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "counterexamples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "policy_candidate": {
      "type": "boolean"
    }
  }
}
