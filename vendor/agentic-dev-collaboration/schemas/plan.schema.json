{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/plan.schema.json",
  "title": "Implementation Plan Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "task_id",
    "owner",
    "status",
    "acceptance_mapping",
    "required_commands",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9A-Za-z._-]+$"
    },
    "task_id": {"type": "string"},
    "owner": {"type": "string"},
    "status": {
      "enum": ["proposed", "approved", "rejected", "superseded"]
    },
    "acceptance_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptance_id", "evidence"],
        "properties": {
          "acceptance_id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2,}$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "required_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "approval": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "approved_at"],
          "properties": {
            "reviewer": {"type": "string", "minLength": 1},
            "approved_at": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {"properties": {"approval": {"type": "object"}}}
    }
  ],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "argv"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
