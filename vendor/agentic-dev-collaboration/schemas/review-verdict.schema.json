{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/review-verdict.schema.json",
  "title": "Independent Review Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "reviewer",
    "review_type",
    "verdict",
    "summary",
    "finding_paths",
    "evidence",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "task_id": {"type": "string"},
    "reviewer": {"type": "string"},
    "review_type": {
      "enum": ["spec_compliance", "code_quality", "security", "contract"]
    },
    "verdict": {"enum": ["PASS", "FAIL", "PARTIAL", "BLOCKED"]},
    "summary": {"type": "string", "minLength": 15},
    "finding_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
