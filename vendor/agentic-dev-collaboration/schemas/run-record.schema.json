{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/run-record.schema.json",
  "title": "Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_envelope",
    "approved_plan",
    "started_at",
    "completed_at",
    "status",
    "assignments",
    "events",
    "artifacts",
    "review_verdicts",
    "verification_verdict",
    "budgets",
    "candidate_lessons"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "task_envelope": {
      "type": "string",
      "minLength": 1
    },
    "approved_plan": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "blocked",
        "cancelled"
      ]
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_verdicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_verdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rework_cycles_used",
        "elapsed_minutes",
        "cost_units"
      ],
      "properties": {
        "rework_cycles_used": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "cost_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "candidate_lessons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
