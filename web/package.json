{
  "name": "trip-web-runtime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:data": "python3 ../scripts/build_all_trip_sites.py --configs ../site-configs --output ../site",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e.mjs && node tests/portal-e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.7",
    "vitest": "^4.1.11"
  }
}
